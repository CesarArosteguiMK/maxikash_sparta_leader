# SPARTA_LEDGER — Apache (httpd): timeouts para operaciones largas (Gastos Cobranza, etc.)
#
# Pegue dentro del <VirtualHost *:443> (o :80) de este sitio, o inclúyalo con Include.
# Reinicie o recargue Apache tras cambios.
#
# 1800 = 30 minutos de espera en la conexión cliente ↔ Apache (y proxy si aplica).

TimeOut 1800

# Si usa mod_proxy hacia otro servidor:
# ProxyTimeout 1800

# Si usa mod_fcgid con PHP:
# FcgidIOTimeout 1800

# PHP (solo si AllowOverride / configuración lo permiten aquí; a veces va en php.ini):
# php_admin_value max_execution_time 0
