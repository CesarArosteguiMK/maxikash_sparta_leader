# SPARTA_LEDGER — Nginx: timeouts para reporte Gastos Cobranza (POST largo a PHP que espera al agente).
#
# Copie el bloque que corresponda a su instalación y ajústelo dentro de `server { ... }`
# o dentro del `location` que ya use para PHP / proxy. Luego: `nginx -t` y `reload`.
#
# Objetivo: evitar "Failed to fetch" en el navegador cuando el reporte tarda 15+ minutos.
# Valor: 1800s = 30 minutos (superior a los ~20 min recomendados).

# ─── Caso A: Nginx hace proxy_pass a Apache/otro upstream (terminación SSL, etc.) ───
# Añada o fusione con su location / o la que enrute a su backend:
#
#   proxy_connect_timeout 60s;
#   proxy_send_timeout    1800s;
#   proxy_read_timeout    1800s;

# ─── Caso B: Nginx + PHP-FPM (fastcgi_pass) — suele ser el cuello (default ~60s) ───
# Dentro del bloque `location ~ \.php$` { ... } o equivalente (incluido front controller index.php):
#
#   fastcgi_connect_timeout 60s;
#   fastcgi_send_timeout    1800s;
#   fastcgi_read_timeout     1800s;
#
# Si solo desea alargar rutas del módulo (front controller único), puede usar un mapa
# o duplicar location con mayor prioridad; lo más simple en muchos despliegues es
# subir fastcgi_read_timeout en todo el server de esta aplicación.

# Ejemplo mínimo fusionable (descomente y adapte rutas/socket):

# location ~ \.php$ {
#     include snippets/fastcgi-php.conf;
#     fastcgi_pass unix:/run/php/php8.2-fpm.sock;
#     fastcgi_read_timeout 1800s;
#     fastcgi_send_timeout 1800s;
# }
