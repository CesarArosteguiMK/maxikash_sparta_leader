# =============================================================================
# Variables de entorno — Sparta Ledger (PHP)
# =============================================================================
# Copiar como .env en la raíz del proyecto. .env está en .gitignore.
# =============================================================================

# --- Verificación automatica S2 de primeros pagos (Cloud Scheduler) ---
# SEGUNDOMETRO_DB_HOST=127.0.0.1
# SEGUNDOMETRO_DB_PORT=3306
# SEGUNDOMETRO_DB_NAME=db-mega-reporte
# SEGUNDOMETRO_DB_USER=usuario
# SEGUNDOMETRO_DB_PASSWORD=clave
# S2_ESTADO_CUENTA_TOKEN=token_s2
# ENDPOINT=https://servicios.s2movil.net/s2maxikash/estadocuenta
# Defensa adicional si el endpoint no está protegido por IAM de Cloud Run:
# SEGUNDOMETRO_PRIMEROS_PAGOS_CRON_SECRET=secreto_largo_aleatorio

# --- Correo (postulaciones Candidatos) — elige UNA forma ---
# Ruta gratis: usar OPCIÓN 2 (SMTP/Gmail) y, si hace falta, el correo secundario opcional.

# OPCIÓN 1 — SendGrid (opcional; revisar plan/costo antes de usar)
# 1) Crear cuenta en https://sendgrid.com
# 2) En SendGrid: Settings → Sender Authentication → verificar el dominio maxikash.mx (SPF/DKIM)
# 3) Settings → API Keys → Create API Key (permiso "Mail Send")
# 4) Poner aquí:
# MAIL_DRIVER=sendgrid
# MAIL_SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxx
# MAIL_FROM=lazaro.gonzalez@__SPARTA_SECRET_REDACTED__.com
# MAIL_FROM_NAME=Capital Humano MaxiKash

# --- Leonidas por WhatsApp Cloud API (Meta) ---
# Leonidas nunca inicia conversaciones desde este canal. Solo responde cuando
# un colaborador escribe primero al numero empresarial.
# WHATSAPP_CLOUD_ENABLED=0
# WHATSAPP_VERIFY_TOKEN=crea_un_token_largo_y_aleatorio
# WHATSAPP_APP_SECRET=app_secret_de_meta
# WHATSAPP_ACCESS_TOKEN=token_permanente_de_system_user
# WHATSAPP_PHONE_NUMBER_ID=id_del_numero_en_whatsapp_manager
# WHATSAPP_GRAPH_VERSION=v23.0
# WHATSAPP_SESSION_SECRET=otro_secreto_largo_y_distinto

# OPCIÓN 2 — SMTP (Gmail, etc.; en Windows suele dar problemas de autenticación)
# Por defecto la app usa 465/SSL para Gmail. Si falla, prueba 587/TLS añadiendo:
# MAIL_GMAIL_FORCE_587=1
# MAIL_DRIVER=smtp
# MAIL_SMTP_HOST=smtp.gmail.com
# MAIL_SMTP_USER=tu_correo@gmail.com
# MAIL_SMTP_PASS=contraseña_de_aplicacion_16_chars
# MAIL_FROM=tu_correo@gmail.com
# MAIL_FROM_NAME=Recursos Humanos
#
# Correo secundario opcional: se usa solo si Gmail rechaza el principal por limite diario.
# MAIL_FALLBACK_SMTP_HOST=smtp.gmail.com
# MAIL_FALLBACK_SMTP_USER=correo_secundario@gmail.com
# MAIL_FALLBACK_SMTP_PASS=contraseña_de_aplicacion_16_chars
# MAIL_FALLBACK_SMTP_PORT=465
# MAIL_FALLBACK_SMTP_SECURE=ssl
# MAIL_FALLBACK_FROM=correo_secundario@gmail.com
# MAIL_FALLBACK_FROM_NAME=Recursos Humanos

# OPCIÓN 3 — PHP mail() (solo si el servidor ya tiene correo configurado; en XAMPP no suele funcionar)
# MAIL_DRIVER=mail
# MAIL_FROM=remitente@tudominio.com
# MAIL_FROM_NAME=Recursos Humanos

# --- Ejemplo mínimo con SendGrid ---
# MAIL_DRIVER=sendgrid
# MAIL_SENDGRID_API_KEY=SG.tu_api_key_aqui
# MAIL_FROM=lazaro.gonzalez@__SPARTA_SECRET_REDACTED__.com
# MAIL_FROM_NAME=Capital Humano MaxiKash
