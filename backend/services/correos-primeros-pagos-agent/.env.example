# Ruta a php.exe (Windows típico)
PHP_PATH=C:\xampp\php\php.exe

# Cada cuánto ejecutar el cron (milisegundos). Default 600000 = 10 minutos
# Los horarios de envío (CDMX) los define el PHP del cron, no este intervalo.
INTERVAL_MS=600000

# Puerto HTTP de estado (0 = desactivar). Default 3110
HTTP_PORT=3110

# Opcional: raíz del proyecto sparta___SPARTA_SECRET_REDACTED__ si el agente no está en la ruta por defecto
# SPARTA_ROOT=C:\xampp\htdocs\sparta___SPARTA_SECRET_REDACTED__

# Opcional: ruta absoluta al script cron (si no, se deduce desde SPARTA_ROOT o desde la carpeta del agente)
# PHP_CRON_SCRIPT=C:\xampp\htdocs\sparta___SPARTA_SECRET_REDACTED__\backend\cronjobs\enviar_primeros_pagos_lunes.php
