# Agente Gastos Cobranza — variables locales (no se versiona; ver .gitignore).
# Tras editar: reiniciar el servicio Node de este agente.

# ── Producción: reporte oficial, guía descargo y sin demo del agente ──
GASTOS_COBRANZA_DEMO=0
REPORTE_COBRANZA_NO_GUARDAR_GUIA_DESCARGO=0
REPORTE_COBRANZA_MODO_PRUEBA_EXCEL=0
# Solo pruebas locales (no usar en servidor): REPORTE_COBRANZA_NO_GUARDAR_GUIA_DESCARGO=1
# Solo pruebas locales: REPORTE_COBRANZA_SIN_DESCARGO=1
# Solo pruebas locales: REPORTE_COBRANZA_MODO_PRUEBA_EXCEL=1

# ── Ejecución diaria del reporte (hora civil CDMX; el proceso Node debe estar SIEMPRE en marcha) ──
# Por defecto sincroniza hora con API en cada tick programado (servidor desfasado). Desactivar sync: GASTOS_GC_AUTO_RUN_SYNC_REMOTE_CLOCK=0
# Desactivar todo el programador: GASTOS_GC_AUTO_RUN_10AM_CDMX=0
# GASTOS_GC_REMOTE_CDMX_TIME=1 opcional: también corrige calendario/archivado en /reportes (además del auto-run)
# GASTOS_GC_AUTO_RUN_HOUR=10
# GASTOS_GC_AUTO_RUN_MINUTE=0
# Ventana tras la hora objetivo (minutos; por defecto 25). Subir si el agente a veces arranca tarde.
# GASTOS_GC_AUTO_RUN_WINDOW_MINUTES=25
# GASTOS_GC_AUTO_RUN_TICK_MS=30000
# Solo lun–vie: GASTOS_GC_AUTO_RUN_WEEKDAYS_ONLY=1
# Diagnóstico: cada ~9 min deja línea [auto-run][debug] en el log
# GASTOS_GC_AUTO_RUN_DEBUG=1

# ── Tras generar reporte_cobranza .xlsx (correo + aviso Google Chat) ──
GASTOS_GC_REPORTE_MAIL_TO=lrgonzalez033@gmail.com,__SPARTA_SECRET_REDACTED__.martinez@__SPARTA_SECRET_REDACTED__.mx
GASTOS_GC_REPORTE_CHAT_WEBHOOK_URL=__SPARTA_WEBHOOK_REDACTED__

# ── Lista negra / worker EC (Google Chat; espacio distinto al post-reporte) ──
GASTOS_GC_EC_CHAT_WEBHOOK_URL=__SPARTA_WEBHOOK_REDACTED__
