# Agente Gastos Cobranza — variables locales (no se versiona; ver .gitignore).
# Tras editar: reiniciar el servicio Node de este agente.

# ── Modo prueba reporte cobranza (no actualiza guia_descargo.json) ──
# Opción A: fusiona descargo al Excel pero NO guarda el checkpoint en guia_descargo.json
REPORTE_COBRANZA_NO_GUARDAR_GUIA_DESCARGO=0

# Opción B (alternativa): descomenta la siguiente y comenta la línea de arriba para NO consultar descargo en absoluto
# REPORTE_COBRANZA_SIN_DESCARGO=1

# Excel de prueba: otro nombre (..._PRUEBA.xlsx); no choca con el reporte oficial del día ni lo sobrescribe
REPORTE_COBRANZA_MODO_PRUEBA_EXCEL=0

# ── Ejecución diaria del reporte (misma lógica que «Ejecutar agente»), hora civil CDMX ──
# El proceso Node revisa cada ~30 s; a las 10:00 CDMX (ventana de minutos configurable) lanza el script.
# No requiere Programador de tareas Windows. Desactivar: GASTOS_GC_AUTO_RUN_10AM_CDMX=0
# Si el reloj del servidor es incorrecto, activar sincronía con API (muy recomendado con auto-run):
# GASTOS_GC_REMOTE_CDMX_TIME=1
# GASTOS_GC_AUTO_RUN_HOUR=10
# GASTOS_GC_AUTO_RUN_MINUTE=0
# GASTOS_GC_AUTO_RUN_WINDOW_MINUTES=5
# GASTOS_GC_AUTO_RUN_TICK_MS=30000
# Solo lun–vie: GASTOS_GC_AUTO_RUN_WEEKDAYS_ONLY=1

# ── Tras generar reporte_cobranza .xlsx (correo + aviso Google Chat) ──
GASTOS_GC_REPORTE_MAIL_TO=lrgonzalez033@gmail.com,__SPARTA_SECRET_REDACTED__.martinez@__SPARTA_SECRET_REDACTED__.mx
GASTOS_GC_REPORTE_CHAT_WEBHOOK_URL=__SPARTA_WEBHOOK_REDACTED__
