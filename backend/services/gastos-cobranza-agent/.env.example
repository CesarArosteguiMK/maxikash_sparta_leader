# Copiar a .env y ajustar. Ver comentarios en server.js (post-run correo + Google Chat).

# Destinatarios del Excel tras reporte exitoso (coma). Si se omite, el PHP usa lista por defecto.
# GASTOS_GC_REPORTE_MAIL_TO=correo1@ejemplo.com,correo2@ejemplo.com

# Webhook entrante de Google Chat (URL completa con key y token). Solo se publica mensaje de texto;
# el adjunto .xlsx va por correo (la API de webhooks de Chat no acepta el archivo binario).
# GASTOS_GC_REPORTE_CHAT_WEBHOOK_URL=https://chat.googleapis.com/v1/spaces/.../messages?key=...&token=...

# Desactivar todo lo anterior tras cada /run exitoso:
# GASTOS_GC_REPORTE_POST_RUN_NOTIFY=0
# Solo desactivar correo:
# GASTOS_GC_REPORTE_MAIL_ENABLED=0
