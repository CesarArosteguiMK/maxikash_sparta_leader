# Copiar a .env y ajustar. Ver comentarios en server.js (post-run correo + Google Chat).

# Si el shell muestra «Agente en línea» pero los botones «Ejecutar proceso 1–3» siguen deshabilitados,
# el agente no está viendo los PHP en backend/cronjobs. Defina la carpeta con los .php (ruta absoluta recomendada):
# GASTOS_GC_CRONJOBS_DIR=C:\\xampp\\htdocs\\sparta___SPARTA_SECRET_REDACTED__\\backend\\cronjobs

# Producción (recomendado en servidor)
# GASTOS_COBRANZA_DEMO=0
# REPORTE_COBRANZA_NO_GUARDAR_GUIA_DESCARGO=0
# REPORTE_COBRANZA_MODO_PRUEBA_EXCEL=0
# Guía incremental descargo estatus 3 (reporte_cobranza.py, descargo_cobranza_gc_estatus3.py, GET /descargo-estatus3/descargar?tipo=guia).
# Localhost: use otro nombre para no pisar checkpoint del servidor (ej. guia_descargo.local.json).
# REPORTE_COBRANZA_DESCARGO_GUIA_BASENAME=guia_descargo.local.json

# Auto-run (reporte 10:00 CDMX): por defecto NO llama a API pública de hora en cada tick (evita ECONNRESET y log lleno).
# Si el servidor tiene hora mala y no usa GASTOS_GC_REMOTE_CDMX_TIME=1, active solo el sync en tick:
# GASTOS_GC_AUTO_RUN_SYNC_REMOTE_CLOCK=1
# Si aun así falla la API, espaciar líneas de error en el log (ms, mínimo 10000; default 300000):
# GASTOS_GC_TIME_SYNC_FAIL_LOG_MIN_MS=600000

# Destinatarios del Excel tras reporte exitoso (coma). Si se omite, el PHP usa lista por defecto.
# GASTOS_GC_REPORTE_MAIL_TO=correo1@ejemplo.com,correo2@ejemplo.com

# Webhook entrante de Google Chat (URL completa con key y token). Solo se publica mensaje de texto;
# el adjunto .xlsx va por correo (la API de webhooks de Chat no acepta el archivo binario).
# GASTOS_GC_REPORTE_CHAT_WEBHOOK_URL=https://chat.googleapis.com/v1/spaces/.../messages?key=...&token=...
# Tras /run: no repetir correo + aviso Chat para el mismo .xlsx (huella nombre+tamaño+mtime) en N horas (default 48).
# GASTOS_GC_REPORTE_POST_DEDUPE_HOURS=48
# Lock corto entre procesos Node; si queda colgado, se considera obsoleto tras estos ms (default 600000 = 10 min).
# GASTOS_GC_REPORTE_POST_LOCK_STALE_MS=600000

# Lista negra / worker EC hacia Google Chat (obligatoria si quieres avisos; espacio distinto al post-reporte).
# GASTOS_GC_EC_CHAT_WEBHOOK_URL=https://chat.googleapis.com/v1/spaces/.../messages?key=...&token=...
# GASTOS_GC_EC_CHAT_ENABLED=1
# Avisos worker_inicio/worker_fin en Chat (por defecto 0 = menos ruido; 1 = incluir inicio/fin del worker PHP).
# GASTOS_GC_EC_CHAT_WORKER_EVENTS=0
# Avisos de los 3 procesos manuales del shell (insertar mora martes, detectar liquidados, eliminar despachos).
# Si no defines URL propia, usa fallback al webhook EC.
# GASTOS_GC_CRONJOBS_CHAT_ENABLED=1
# GASTOS_GC_CRONJOBS_CHAT_WEBHOOK_URL=https://chat.googleapis.com/v1/spaces/.../messages?key=...&token=...

# Desactivar todo lo anterior tras cada /run exitoso:
# GASTOS_GC_REPORTE_POST_RUN_NOTIFY=0
# Solo desactivar correo:
# GASTOS_GC_REPORTE_MAIL_ENABLED=0
# Ruta absoluta opcional para el archivo 1/0 del toggle «automático» (por defecto: data/ luego %TEMP% luego logs legacy).
# GASTOS_GC_AUTO_RUN_RUNTIME_FILE=C:\\ruta\\auto_run_reporte_runtime.txt
