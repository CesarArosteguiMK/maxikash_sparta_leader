# Config del worker EC: versionado para que clone/pull en servidor tenga TOKEN y webhook sin paso manual.
# TOKEN = API S2 (estado de cuenta), NO es la URL de Chat
TOKEN=__SPARTA_TOKEN_REDACTED__
ENDPOINT=https://servicios.s2movil.net/s2__SPARTA_SECRET_REDACTED__/estadocuenta

# Webhook entrante Google Chat (espacio Estado de cuenta - AVISO)
GOOGLE_CHAT_WEBHOOK_URL=__SPARTA_WEBHOOK_REDACTED__

DELAY_MS_BETWEEN_CREDITS=500
