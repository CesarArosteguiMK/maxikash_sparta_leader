# Plantilla: el repo incluye config.local.env para despliegues; copie este archivo si necesita un segundo entorno local.
#
# API S2 — mismo contrato que usa Sparta (Estado de cuenta)
TOKEN=
ENDPOINT=https://servicios.s2movil.net/s2__SPARTA_SECRET_REDACTED__/estadocuenta

# Webhook entrante de Google Chat (URL completa; no compartir públicamente)
GOOGLE_CHAT_WEBHOOK_URL=https://chat.googleapis.com/v1/spaces/SPACE_ID/messages?key=KEY&token=TOKEN

# Pausa entre llamadas a S2 (milisegundos) para no saturar
DELAY_MS_BETWEEN_CREDITS=500

# Opcional: fecha de corte YYYY-MM-DD (misma que recibe la API; por defecto día actual)
# FECHA_CORTE=2026-03-25

# Usuario grabado en auditoria___SPARTA_SECRET_REDACTED__ (el worker no tiene sesión web)
# EC_WORKER_AUDITORIA_USUARIO=ec-webhook-worker

# Opcional: ruta al archivo de IDs (por defecto ./creditos.txt junto al worker)
# CREDITOS_FILE=C:\ruta\creditos.txt
#
# Excel: usar en CLI  php worker.php --ids-xlsx="C:\ruta\lote.xlsx"  (columna ID CREDITO por defecto)
