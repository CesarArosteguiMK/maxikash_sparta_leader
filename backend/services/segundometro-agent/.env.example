# Agente Segundómetro - variables de entorno
# Copiar a .env y ajustar. No commitear .env con claves.

PORT=3100
# Opcional: si se define, las peticiones deben enviar header X-Api-Key con este valor
# API_KEY=mi-clave-secreta

# Si no hay salida a internet, las APIs de hora CDMX fallan. Con 1 se usa reloj local del PC (recomendado en laptops aisladas).
# ALLOW_LOCAL_TIME_FALLBACK=1

# SSH al servidor donde están los reportes
SSH_HOST=34.173.106.81
SSH_USER=jesus
# Ruta a la clave privada DENTRO del agente. Por defecto: keys/jesusssh4.unknown
# Copia tu archivo .unknown en la carpeta keys/ del agente (ver keys/README.txt).
# Así el agente no depende de Sparta Ledger ni de permisos en backend/config/ssh.
SSH_KEY_PATH=keys/jesusssh4.unknown
# Tiempo de apertura SFTP al descargar ZIP historico (2 min por defecto).
# SSH_DOWNLOAD_READY_TIMEOUT_MS=120000

# Directorio remoto de reportes
REMOTE_DIR=/home/usuariossftp/s2/mega_reporte

# Script de monitoreo en el servidor remoto
MONITOREAR_SCRIPT=/home/jesus/scripts/monitorear.sh

# Opcional: URL directa al endpoint PHP para truncar automático.
# Si no se define, el agente intenta autodetectar localhost igual que SEGUNDOMETRO_ESTADO_BD_URL.
# SEGUNDOMETRO_TRUNCAR_AUTO_URL=http://127.0.0.1/index.php?url=segundometro/truncarAutomaticoAgente
# Misma clave que config.ini segundometro_agent_key (header X-Agent-Key en el POST a PHP).
# SEGUNDOMETRO_AGENT_KEY=
# El truncar automático (martes) usa el mismo interruptor que Auto-copy en data/auto-copy-config.json (enabled).
# Apágalo desde la UI del agente o poniendo enabled: false en ese JSON.

# Rama especial de respaldo para martes 07:31 (validada por BD en 07:40):
# comando remoto a ejecutar por SSH cuando BD=error en ese slot.
# Placeholders disponibles: {archivo}, {archivo_base}, {fecha}, {slot}
# Ejemplo:
# MARTES_SEMANAL_REMOTE_COMMAND=cd /home/jesus/scripts && python3 insertar_martes_semanal.py "/home/usuariossftp/s2/mega_reporte/{archivo_base}"
# MARTES_SEMANAL_TIMEOUT_MS=900000
