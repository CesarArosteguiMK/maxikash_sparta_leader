# Copiar a .env (no subir .env al repo)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=__SPARTA_SECRET_REDACTED__
MYSQL_PASSWORD=cambiar
# Base __SPARTA_SECRET_REDACTED__ (histórico primeros pagos: tbl_histo_primeros_pagos; opcional PP_HISTO_TABLA)
MYSQL_DB=__SPARTA_SECRET_REDACTED__

# Puerto del mini servidor Flask
PORT=5055

# Candidatas de semana: agregado SQL (no 350k filas al Python). Tope de grupos distintos a considerar
# PP_HISTO_CANDIDATAS_GROUP_LIMIT=50
# Ventana días hacia atrás
# PP_HISTO_LOOKBACK_DIAS=30
# Cuántas semanas devolver
# PP_HISTO_NUM_SEMANAS=5
# MYSQL_READ_TIMEOUT=120
# 1=total de filas por etiqueta (≈69k; lento)
# PP_HISTO_INCLUIR_CONTEO_ETIQUETA=0
# 1=una semana detrás de otra (recom. en remoto). 2–3 si el servidor aguanta
# PP_HISTO_WORKERS=1
# Tabla histórico primeros pagos (default tbl_histo_primeros_pagos)
# PP_HISTO_TABLA=tbl_histo_primeros_pagos
