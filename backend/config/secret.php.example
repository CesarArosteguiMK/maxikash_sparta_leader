<?php
/**
 * Configuración para "Analizar con IA" (Sabueso > Panel Admin).
 *
 * CÓMO USAR:
 * 1. Copiar este archivo como secret.php en esta misma carpeta:
 *    cp secret.php.example secret.php
 * 2. Obtener una API key en https://platform.openai.com/api-keys
 * 3. En secret.php, reemplazar 'tu_clave_openai_aqui' por tu clave real.
 *
 * El archivo secret.php no se sube a Git (está en .gitignore).
