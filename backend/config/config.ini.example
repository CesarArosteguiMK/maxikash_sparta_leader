; Copiar como config.ini y rellenar con valores reales. NO subir config.ini (está en .gitignore).

[database]
SERVIDOR = "localhost"
PUERTO = 3306
; Conexión general de la app (puede ser reportes u otra BD).
ESQUEMA = "nombre_esquema"
; OBLIGATORIO para tickets si ESQUEMA no es __SPARTA_SECRET_REDACTED__: ticket, asignacion_ticket, ticket_evidencia, etc. viven aquí.
; Los scripts en backend/scripts que tocan tickets usan ESQUEMA_TICKETS o, por defecto, __SPARTA_SECRET_REDACTED__ — no usan ESQUEMA.
ESQUEMA_TICKETS = "__SPARTA_SECRET_REDACTED__"
USUARIO = "usuario"
PASSWORD = "contraseña"

[webhook]
GOOGLE_CHAT = "https://chat.googleapis.com/..."

[pdf_media]
python_path = "/ruta/a/python"

[ssh]
ssh_use_plink = 0
ssh_command = /usr/bin/ssh
ssh_key = /ruta/a/clave_privada
; ssh_command_plink, ssh_key_plink, ssh_hostkey, ssh_pscp = según entorno

; Sonda HTTP del agente Node de correos (Primeros pagos — Lunes). La UI usa esto para el badge "Agente: en línea".
[correos_primeros_pagos_agent]
enabled = 1
url = "http://127.0.0.1:3110"
