; Copiar como config.ini y rellenar con valores reales. NO subir config.ini (está en .gitignore).

[database]
SERVIDOR = "localhost"
PUERTO = 3306
; Conexión general de la app (puede ser reportes u otra BD).
ESQUEMA = "nombre_esquema"
; OBLIGATORIO para tickets si ESQUEMA no es __SPARTA_SECRET_REDACTED__: ticket, asignacion_ticket, ticket_evidencia, etc. viven aquí.
; Los scripts en backend/scripts que tocan tickets usan ESQUEMA_TICKETS o, por defecto, __SPARTA_SECRET_REDACTED__ — no usan ESQUEMA.
ESQUEMA_TICKETS = "__SPARTA_SECRET_REDACTED__"
USUARIO = "usuario"
PASSWORD = "contraseña"

[webhook]
GOOGLE_CHAT = "https://chat.googleapis.com/..."

[pdf_media]
python_path = "/ruta/a/python"

[ssh]
ssh_use_plink = 0
ssh_command = /usr/bin/ssh
ssh_key = /ruta/a/clave_privada
; ssh_command_plink, ssh_key_plink, ssh_hostkey, ssh_pscp = según entorno

; API Python de verificación de documentos + extracción FAD (Sabueso "donde trabaja").
; No la levanta XAMPP: ejecutar backend\API\iniciar-agente.bat (puerto 8000) o Docker.
; api_url: puede ser …/api/v1/verificar (recomendado), …/verificar sobre el host, o http://127.0.0.1:8000 (se añade /api/v1 solo).
[doc_verificacion]
api_url = "http://127.0.0.1:8000/api/v1/verificar"
api_key = "sparta-__SPARTA_SECRET_REDACTED__-doc-verificacion-key"
; Tipo de identificación que PHP envía a /validar-expediente (Query + Form). INE_NUEVA = credencial para votar actual; residencia = RESIDENCIA_TEMPORAL, etc.
validar_expediente_tipo_documento = INE_NUEVA
; POST /validar-expediente (varios PDF). Por solicitud; si la API tarda mucho en OCR, subir (máx. 600).
validar_expediente_timeout_seconds = 300
; Reintentos extra tras fallos transitorios (timeout, 502/503/504, conexión). 2 = hasta 3 intentos en total.
; Si la API se cuelga sin enviar bytes, Sparta no reintenta igual (evita 3×240 s). Para stalls frecuentes use 1.
validar_expediente_retries = 1
; Si la velocidad de descarga queda por debajo de este límite (bytes/s) durante low_speed_time s, cURL aborta (antes que timeout total).
; Evita esperar p. ej. 240 s con "0 bytes received" cuando el worker Python está colgado.
validar_expediente_low_speed_time_seconds = 90
validar_expediente_low_speed_limit_bps = 32
; 1 = diagnóstico: tras subir documentos la verificación automática solo envía el PDF de identificación (no CURP/NSS/constancia/acta). Quitar en producción.
validar_expediente_solo_identificacion = 0

; Sonda HTTP del agente Node de correos (Primeros pagos — Lunes). La UI usa esto para el badge "Agente: en línea".
[correos_primeros_pagos_agent]
enabled = 1
url = "http://127.0.0.1:3110"
