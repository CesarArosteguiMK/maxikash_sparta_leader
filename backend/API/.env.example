# ============================================================
# VARIABLES DE ENTORNO - Copiar como .env y completar valores
# ============================================================

# --- App ---
APP_NAME="Doc Verificacion API"
APP_VERSION="1.0.0"
DEBUG=false
SECRET_KEY=CAMBIA_ESTO_POR_UNA_CLAVE_SECRETA_SEGURA

# --- API Keys (para clientes que consumen la API) ---
API_KEY_HEADER=X-API-Key
# Clave única para clientes (la app no persiste keys en BD hoy)
MASTER_API_KEY=CAMBIA_ESTO

# --- Base de datos (solo Settings; la API no abre conexión en el código actual) ---
# Por defecto en código: sqlite:///./temp_verificacion.db
# MySQL lo usa Sparta Ledger (PHP), no esta API Python.
DATABASE_URL=sqlite:///./temp_verificacion.db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# --- Redis (opcional / futuro; no se usa en rutas actuales) ---
REDIS_URL=redis://localhost:6379/0

# --- Tesseract OCR ---
# En Windows deje vacío o omita la línea para autodetectar (incluye backend/API/tools/tesseract.exe).
# Solo en Linux servidor típico: TESSERACT_CMD=/usr/bin/tesseract
#TESSERACT_CMD=

# --- Google Vision API (opcional) ---
USE_GOOGLE_VISION=false
GOOGLE_APPLICATION_CREDENTIALS=/path/to/credentials.json

# --- Modelo ML ---
ML_MODEL_PATH=./models/efficientnet_documentos.pth
ML_MODEL_THRESHOLD=0.5
USE_ML_CLASSIFIER=false   # Poner true cuando tengas el modelo entrenado

# --- Rate Limiting ---
RATE_LIMIT_PER_MINUTE=30
RATE_LIMIT_PER_DAY=500

# --- Procesamiento de Imágenes ---
MAX_IMAGE_SIZE_MB=10
ALLOWED_EXTENSIONS=jpg,jpeg,png,webp,tiff
IMAGE_MAX_WIDTH=4000
IMAGE_MAX_HEIGHT=4000

# --- Umbrales de Score ---
UMBRAL_REAL=75
UMBRAL_REVISION=50

# --- Almacenamiento temporal ---
TEMP_UPLOAD_DIR=/tmp/doc_verificacion
DELETE_TEMP_AFTER_SECONDS=300

# --- CORS ---
CORS_ORIGINS=http://localhost:3000,https://tu-frontend.com
