# Motor documental y cerebro de Leonidas
DOC_AI_ENGINE=gemini

# Cree la clave en Google AI Studio y guardela solo en el servidor.
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-3.5-flash
GEMINI_CROSSCHECK_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite
GEMINI_CROSSCHECK_FALLBACK_MODELS=gemini-3.1-flash-lite
GEMINI_RETRY_DELAYS=0,1
GEMINI_TIMEOUT_SECONDS=45

# El resto de variables depende del entorno de Sparta.
MASTER_API_KEY=
