# Motor documental y cerebro de Leonidas
DOC_AI_ENGINE=gemini

# Cree la clave en Google AI Studio y guardela solo en el servidor.
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-3.6-flash
GEMINI_QUICK_MODEL=gemini-3.5-flash-lite
GEMINI_CROSSCHECK_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite
GEMINI_CROSSCHECK_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite
GEMINI_RETRY_DELAYS=0,1
GEMINI_TIMEOUT_SECONDS=45
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
GEMINI_TTS_VOICE=Algenib
GEMINI_TTS_TIMEOUT_SECONDS=45
GEMINI_TTS_INSTRUCTIONS=Habla en espanol de Mexico con una voz masculina adulta, grave, firme, madura y calida. Suena como un comandante espartano sereno, seguro, directo y humano. Usa diccion clara, ritmo conversacional y pausas naturales. Evita sonar robotico, caricaturesco, teatral, agresivo o como locutor comercial.
DOC_AI_QUICK_TIMEOUT_SECONDS=30
DOC_AI_CROSSCHECK_TIMEOUT_SECONDS=45

# Segundo knockout de motos adjudicadas. La llave real vive solo en backend/API/.env del servidor.
# Mientras ADJUDICACION_KO_IA_ENABLED=0, el flujo actual no cambia.
ADJUDICACION_KO_IA_ENABLED=0
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MOTO_MODEL=claude-sonnet-4-20250514
ANTHROPIC_TIMEOUT_SECONDS=120
# Opcional: ruta absoluta de ffmpeg en el servidor. Si se omite, se busca ffmpeg en PATH.
ADJUDICACION_IA_FFMPEG_PATH=

# El resto de variables depende del entorno de Sparta.
MASTER_API_KEY=
