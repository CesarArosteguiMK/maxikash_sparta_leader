# ========== Credenciales y configuración (NUNCA subir) ==========
.env
backend/config/config.ini
backend/config/secret.php
backend/config/master_key.php

# ========== Llaves SSH (OpenSSH PEM / PuTTY .ppk) ==========
backend/config/ssh/*.unknown
backend/config/ssh/*.key
backend/config/ssh/*.pem
backend/config/ssh/*.ppk
backend/config/ssh/jesusssh4.ppk
backend/config/ssh/jesusssh4.unknown

# ========== Certificados SSL (backend/BD: server-ca, client-cert, client-key) ==========
# Incluye variantes con (1), (3), etc. que genera Windows al descargar de nuevo
backend/BD/*.pem
backend/BD/server-ca.pem
backend/BD/client-cert.pem
backend/BD/client-cert*.pem
backend/BD/client-key.pem
backend/BD/client-key*.pem
backend/BD/geo_ssl_*.pem

# ========== Excepciones en backend/config/ssh (sí van a Git) ==========
!backend/config/ssh/.gitkeep
!backend/config/ssh/README.md
!backend/config/ssh/fix_permissions.bat

# ========== Test y diagnóstico (no subir; pueden exponer rutas) ==========
public/test_geo_ssl.php

# ========== Medios temporales y logs ==========
backend/storage/tmp_media/
backend/storage/tmp_mpdf/
backend/storage/logs/
backend/storage/logs/*.log
backend/storage/logs/*
!backend/storage/logs/.gitkeep
backend/cronjobs/logs/

# ========== Zip empaquetado de API (no subir el .zip; la carpeta backend/API/ sí va al repo) ==========
backend/API.zip

# ========== Zips de agente / APIs (no subir) ==========
backend/services/segundometro-agent.zip

# (si antes tenías entradas concretas aquí, la carpeta completa las cubre)

# ========== Rate limiting (login) ==========
backend/storage/rate_limit/
!backend/storage/rate_limit/.gitkeep

# ========== Caché (geocode megareporte, etc.) — generada en runtime; evita conflictos add/add en pull ==========
# Ignorar contenido pero no la carpeta (así .gitkeep sí se trackea; cache/ entero bloquearía el !)
backend/storage/cache/*
!backend/storage/cache/.gitkeep

# ========== Reporte semanal Sabueso (snapshot JSON; sin BD; regenerable al abrir sin archivo) ==========
backend/storage/reporte_semanal_global/*.json
!backend/storage/reporte_semanal_global/.gitkeep

# ========== Agente Segundómetro (Node) — carpeta versionada; llaves NO ==========
# Copie aqui la clave local (p. ej. jesusssh4.unknown). Nunca subir al repo.
backend/services/segundometro-agent/keys/**
!backend/services/segundometro-agent/keys/.gitkeep
!backend/services/segundometro-agent/keys/README.md

# ========== Agente correos primeros pagos — SÍ VA AL REPOSITORIO ==========
# backend/services/correos-primeros-pagos-agent/ está versionado (package.json, index.js, .bat, etc.).
# En el servidor: git pull + npm ci o instalar-agente.bat. node_modules/ y .env siguen en .gitignore de esa carpeta.

# ========== Pruebas OCR (no subir; puedes copiar archivos nuevos, no se subirán) ==========
pruebas_OCR/
