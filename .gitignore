# ========== Credenciales y configuración (NUNCA subir) ==========
.env
# Excepción: .env del agente Gastos Cobranza se versiona para que el servidor reciba variables sin configuración manual.
!backend/services/gastos-cobranza-agent/.env
backend/config/config.ini
backend/config/secret.php
backend/config/master_key.php
backend/config/rrhh_sensitive.key
backend/config/rrhh_documents.key
scripts/.mega_reporte_mysql_password

# ========== Llaves SSH (OpenSSH PEM / PuTTY .ppk) ==========
backend/config/ssh/*.unknown
backend/config/ssh/*.key
backend/config/ssh/*.pem
backend/config/ssh/*.ppk
backend/config/ssh/jesusssh4.ppk
backend/config/ssh/jesusssh4.unknown

# ========== Certificados SSL (backend/BD: server-ca, client-cert, client-key) ==========
# Incluye variantes con (1), (3), etc. que genera Windows al descargar de nuevo
backend/BD/*.pem
backend/BD/server-ca.pem
backend/BD/client-cert.pem
backend/BD/client-cert*.pem
backend/BD/client-key.pem
backend/BD/client-key*.pem
backend/BD/geo_ssl_*.pem

# ========== Excepciones en backend/config/ssh (sí van a Git) ==========
!backend/config/ssh/.gitkeep
!backend/config/ssh/README.md
!backend/config/ssh/fix_permissions.bat

# ========== Test y diagnóstico (no subir; pueden exponer rutas) ==========
public/test_geo_ssl.php
tmp/
%TEMP%/
output/
tmp_atlas_audits/
.tmp_template_inspect/
tmp_*.php
scripts/tmp_*.php
scripts/tmp_*_out/

# ========== Subidas públicas (runtime; no versionar contenido) ==========
public/uploads/**
!public/uploads/.gitkeep
!public/uploads/documentos_despacho/.gitkeep

# ========== Medios temporales y logs (RUNTIME: nunca git add de .log) ==========
# Generan archivos .log: EstadoCuenta (engine→storage/logs), EstadoCuentaTimingLog, Api (location_audit),
# LoginRateLimit, SegundometroDAO (ssh_debug), Ticket (dictamen_error), LocationAuditLogger,
# cronjobs sync_gastos_cobranza / morosidad / limpiar_tmp_media, Python backend/API (uvicorn).
*.log
**/*.log
/*.log
logs/**
!logs/.gitkeep
backend/logs/**
backend/API/logs/**
backend/API/storage/doc_ai_quick_cache/**
backend/storage/tmp_media/
backend/storage/tmp_mpdf/
backend/storage/tmp_rrhh_import/
storage/evidencias_respaldo/
# Artefactos generados localmente por herramientas y pruebas 3D; no son parte del despliegue.
storage/tools/
storage/design-rejected/
storage/leonidas-helmet-designs/
storage/leonidas-helmet-reconstruction/
backend/storage/runtime/
backend/storage/leonidas/*.jsonl
backend/storage/leonidas_media/
backend/storage/.vertex-ai-token.json
.phpunit.result.cache
# Expedientes/documentos de candidatos (runtime; no subir PDFs ni archivos personales al repo)
backend/storage/candidatos/**
!backend/storage/candidatos/.gitkeep
!backend/storage/candidatos/**/.gitkeep
# Contenido de storage/logs ignorado; la carpeta se versiona con .gitkeep (git no re-incluye hijos si se ignora el directorio padre entero).
backend/storage/logs/*
!backend/storage/logs/.gitkeep
backend/cronjobs/logs/**
backend/services/gastos-cobranza-agent/tools/**/logs/**
backend/services/gastos-cobranza-agent/tools/**/*.log

# ========== Python portable embebido (API local): runtime pesado; no versionar ==========
# Si alguna vez se trackeó, "git pull" en Windows puede fallar al reemplazar pip.exe (archivo en uso).
# Recrear en cada máquina: backend/API/venv + requirements.txt o launcher/instalar-agente.bat
backend/API/venv/
backend/API/.venv/
backend/API/.paddlex_cache/
backend/API/.paddlex_cache_runtime/
backend/API/.paddle_home/
backend/API/tools/PythonPortable/
backend/API/tools/pythonportable/
backend/API/tools/PythonPortable/**

# ========== Zip empaquetado de API (no subir el .zip; la carpeta backend/API/ sí va al repo) ==========
backend/API.zip

# ========== Zips de agente / APIs (no subir) ==========
backend/services/segundometro-agent.zip

# (si antes tenías entradas concretas aquí, la carpeta completa las cubre)

# ========== Rate limiting (login) ==========
backend/storage/rate_limit/
!backend/storage/rate_limit/.gitkeep

# ========== Caché (geocode megareporte, etc.) — generada en runtime; evita conflictos add/add en pull ==========
# Ignorar contenido pero no la carpeta (así .gitkeep sí se trackea; cache/ entero bloquearía el !)
backend/storage/cache/*
!backend/storage/cache/.gitkeep

# ========== Reporte semanal Sabueso (snapshot JSON; sin BD; regenerable al abrir sin archivo) ==========
backend/storage/reporte_semanal_global/*.json
!backend/storage/reporte_semanal_global/.gitkeep

# ========== Avance de Onboarding (datos de usuarios en runtime) ==========
backend/storage/onboarding/progress.json
!backend/storage/onboarding/.gitkeep
public/reset_onboarding_progress.php
public/diploma_prueba_horizontal.php

# ========== Agente Segundómetro (Node) — carpeta versionada; llaves NO ==========
# Copie aqui la clave local (p. ej. jesusssh4.unknown). Nunca subir al repo.
backend/services/segundometro-agent/keys/**
!backend/services/segundometro-agent/keys/.gitkeep
!backend/services/segundometro-agent/keys/README.md

# ========== Agente correos primeros pagos — SÍ VA AL REPOSITORIO ==========
# backend/services/correos-primeros-pagos-agent/ está versionado (package.json, index.js, .bat, etc.).
# En el servidor: git pull + npm ci o instalar-agente.bat. node_modules/ y .env siguen en .gitignore de esa carpeta.

# ========== Pruebas OCR (no subir; puedes copiar archivos nuevos, no se subirán) ==========
pruebas_OCR/

# ========== PoC IA documental Gemini (experimento local; no subir keys, documentos ni resultados) ==========
experiments/gemini_document_poc/

# ========== Python: bytecode y caché de tests (regenerable; no versionar) ==========
**/__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/

# ========== Generado por scripts/extraer_script_ticket_sabueso.php ==========
backend/storage/script_ticket_extraido.js

